{% set build_number = 52 %}

package:
  name: _openmp_mutex
  version: {{ version }}

build:
  number: {{ build_number }}
  string: {{ build_number }}_{{ openmp_mutex_impl }}
  # Only the LLVM mutex carries compatibility symlinks. GNU, Intel, and MSVC
  # variants are pure solver markers; their runtimes come from compiler/runtime
  # packages and their run_exports.
  script: bash "${RECIPE_DIR}/build_links.sh"  # [unix and openmp_mutex_impl == "llvm"]
  always_include_files:
    # These links intentionally point at files supplied by llvm-openmp. We do
    # not depend on llvm-openmp here so the mutex remains a selector, while
    # still matching conda-forge's libgomp compatibility behavior.
    - lib/libgomp.so.1     # [linux and openmp_mutex_impl == "llvm"]
    - lib/libgomp.1.dylib  # [osx and openmp_mutex_impl == "llvm"]
    - lib/libgomp.dylib    # [osx and openmp_mutex_impl == "llvm"]
  run_exports:
    # Packages that host-depend on the mutex should carry the same selected
    # mutex family forward instead of solving to a newer different family.
    - {{ pin_subpackage('_openmp_mutex', max_pin=None) }} *_{{ openmp_mutex_impl }}

test:
  commands:
    - echo "{{ openmp_mutex_impl }} mutex selected"
    # LLVM packages should provide the compatibility links, even though their
    # targets may be dangling until llvm-openmp is installed in the environment.
    - test -L "${PREFIX}/lib/libgomp.so.1"  # [linux and openmp_mutex_impl == "llvm"]
    - test "$(readlink "${PREFIX}/lib/libgomp.so.1")" = "libomp.so"  # [linux and openmp_mutex_impl == "llvm"]
    - test -L "${PREFIX}/lib/libgomp.1.dylib"  # [osx and openmp_mutex_impl == "llvm"]
    - test "$(readlink "${PREFIX}/lib/libgomp.1.dylib")" = "libomp.dylib"  # [osx and openmp_mutex_impl == "llvm"]
    - test -L "${PREFIX}/lib/libgomp.dylib"  # [osx and openmp_mutex_impl == "llvm"]
    - test "$(readlink "${PREFIX}/lib/libgomp.dylib")" = "libomp.dylib"  # [osx and openmp_mutex_impl == "llvm"]
    # GNU marker packages must not ship libgomp compatibility files. libgomp
    # itself owns the real runtime library.
    - test ! -e "${PREFIX}/lib/libgomp.so.1"  # [linux and openmp_mutex_impl != "llvm"]

about:
  summary: Mutex metapackage for selecting a single OpenMP runtime family
  license: BSD-3-Clause
  license_family: BSD
  license_file: LICENSE
  home: https://github.com/AnacondaRecipes/_openmp_mutex-feedstock
  description: |
    _openmp_mutex is a lightweight selector package used to keep environments
    on a single OpenMP runtime family. Variants use family-specific build
    strings so runtime packages can constrain solver behavior without this
    package owning the runtime libraries themselves.

extra:
  recipe-maintainers:
    - ELundby45
# Keep the version in sync with pydantic-feedstock because the latest version can be incompatible.
{% set name = "pydantic-core" %}
{% set version = "2.50.1" %}

package:
  name: {{ name|lower }}
  version: {{ version }}

source:
  url: https://pypi.org/packages/source/{{ name[0] }}/{{ name }}/{{ name.replace('-', '_')}}-{{ version }}.tar.gz
  sha256: e50d7b94baac6c7d09927fa5ca5800a0c7ee5015c7fcff65beb3a1931b5a6e09

build:
  number: 0
  script:
    # Not abi3. A leaked PYO3_USE_ABI3_FORWARD_COMPATIBILITY (win-arm64 workers)
    # makes pyo3 set Py_LIMITED_API and the Rust build fails.
    - unset PYO3_USE_ABI3_FORWARD_COMPATIBILITY  # [not win]
    - set PYO3_USE_ABI3_FORWARD_COMPATIBILITY=   # [win]
    - {{ PYTHON }} -m pip install . -vv --no-deps --no-build-isolation
    - cargo-bundle-licenses --format yaml --output THIRDPARTY.yml
  skip: true  # [py<310]

requirements:
  build:
    - {{ stdlib('c') }}
    - {{ compiler("c") }}
    - {{ compiler("rust") }}
    - cargo-bundle-licenses
  host:
    - pip
    - python
    - maturin >=1.15.0,<2
  run:
    - python
    - typing-extensions >=4.16.0

#E   pytest.PytestUnknownMarkWarning: Unknown pytest.mark.thread_unsafe - is this a typo?
# No pytest-run-parallel here, so downgrade that mark to a warning instead of skipping.
test:
  source_files:
    - tests
    - pyproject.toml
  imports:
    - pydantic_core
  commands:
    - pip check
    - python -c "from pydantic_core import PydanticUndefinedType"
    # downgrade unknown thread_unsafe marks to warnings (see comment above).
    # newer pytest (9.x) also flags class-scoped fixtures defined as instance methods; downgrade that too.
    # test_allow_partial.py::test_set_frozenset[set_schema] hits an inline-snapshot internal AssertionError
    # unrelated to pydantic-core behavior; skip it.
    # pytest-examples is not on defaults; test_tzinfo imports pydantic (circular).
    - pytest -vv --ignore=tests/test_docstrings.py --ignore=tests/test_tzinfo.py --ignore=tests/validators/test_allow_partial.py -W default::pytest.PytestUnknownMarkWarning -W default::pytest.PytestRemovedIn10Warning
  requires:
    - pip
    - pytest
    - hypothesis
    - typing-inspection >=0.4.1
    - dirty-equals
    - pytest-benchmark
    - pytest-timeout
    - pytest-mock
    - inline-snapshot

about:
  home: https://github.com/pydantic/pydantic
  license: MIT
  license_family: MIT
  license_file:
    - LICENSE
    - THIRDPARTY.yml
  summary: Core validation logic for pydantic written in rust
  description: |
    This package provides the core functionality for pydantic validation and serialization.
  dev_url: https://github.com/pydantic/pydantic
  doc_url: https://pydantic.dev/docs
  
extra:
  recipe-maintainers:
    - xhochy
    - samuelcolvin
    - adriangb
    - dmontagu
    - pavelzw

{% set xorg_name = "libpthread-stubs" %}
{% set xorg_category = "xcb" %}
{% set name = "pthread-stubs" %}
{% set version = "0.3" %}
{% set sha256 = "35b6d54e3cc6f3ba28061da81af64b9a92b7b757319098172488a660e3d87299" %}
{% set am_version = "1.15" %} # keep synchronized with build.sh

package:
  name: {{ name|lower }}
  version: {{ version }}

source:
  url: https://www.x.org/releases/individual/{{ xorg_category }}/{{ xorg_name }}-{{ version }}.tar.bz2
  sha256: {{ sha256 }}

# NOTE: no Visual Studio dependent features, since this package does not build
# or install any binary code on Windows. It needs ucrt64-toolchain for the
# configure script to run, but msys2 provides sufficient pthreads bits for
# downstream packages.

build:
  number: 2
  skip: true  # [win]
  detect_binary_files_with_prefix: true

requirements:
  build:
    - {{ stdlib('c') }}              # [not win]
    - {{ compiler('c') }}            # [not win]
    - make                           # [not win]
    - pkg-config                     # [not win]
    - libtool                        # [not win]
    - msys2-autoconf                 # [win]
    - msys2-automake{{ am_version }} # [win]
    - msys2-libtool                  # [win]
    - ucrt64-pkg-config              # [win]
    - ucrt64-toolchain               # [win]
    - msys2-pkg-config               # [win]
    - msys2-posix                    # [win]
    - msys2-libtool                  # [win]
    # - xorg-util-macros

test:
  commands:
    - test -f ${PREFIX}/lib/pkgconfig/pthread-stubs.pc  # [not win]
    - exists %PREFIX%/lib/pkgconfig/pthread-stubs.pc    # [win]

about:
  home: https://xcb.freedesktop.org/
  license: MIT
  license_family: MIT
  license_file: COPYING
  description: |
    This library provides weak aliases for pthread functions not
    provided in libc or otherwise available by default.
  summary: "Stubs missing from libc for standard pthread functions"
  dev_url: https://gitlab.freedesktop.org/xorg/lib/pthread-stubs
  doc_url: https://gitlab.freedesktop.org/xorg/lib/pthread-stubs

extra:
  recipe-maintainers:
    - ccordoba12
    - mingwandroid
    - pkgw
